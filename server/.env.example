NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Supabase runtime connection: Connect > ORMs > Prisma > Session pooler.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public&sslmode=require
# Supabase direct connection used by Prisma migrations.
DIRECT_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public&sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGIN=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MOCK_MODE=false
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1600
AI_MAX_CONTEXT_TASKS=250
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
COOKIE_SECURE=false
